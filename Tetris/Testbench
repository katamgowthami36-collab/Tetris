`timescale 1ns/1ps

module tetris_game_tb;

    reg clk;
    reg reset;
    reg move_left;
    reg move_right;
    reg drop;

    wire [3:0] block_x;
    wire [4:0] block_y;
    wire game_over;

    tetris_game uut (
        .clk(clk),
        .reset(reset),
        .move_left(move_left),
        .move_right(move_right),
        .drop(drop),
        .block_x(block_x),
        .block_y(block_y),
        .game_over(game_over)
    );

    // Clock generation
    always #5 clk = ~clk;

    initial begin

        clk = 0;
        reset = 1;
        move_left = 0;
        move_right = 0;
        drop = 0;

        $display("===============================================");
        $display("             VERILOG TETRIS GAME");
        $display("===============================================");
        $display("Time   X Position   Y Position   Game Over");
        $display("-----------------------------------------------");

        // Reset
        #10;
        reset = 0;

        // Automatic falling
        #10;
        $display("%4t       %2d           %2d          %b",
                 $time, block_x, block_y, game_over);

        #10;
        $display("%4t       %2d           %2d          %b",
                 $time, block_x, block_y, game_over);

        // Move left
        move_left = 1;

        #10;
        $display("%4t       %2d           %2d          %b",
                 $time, block_x, block_y, game_over);

        move_left = 0;

        // Move right
        move_right = 1;

        #10;
        $display("%4t       %2d           %2d          %b",
                 $time, block_x, block_y, game_over);

        move_right = 0;

        // Drop block
        drop = 1;

        #10;
        $display("%4t       %2d           %2d          %b",
                 $time, block_x, block_y, game_over);

        drop = 0;

        // Continue falling
        #10;
        $display("%4t       %2d           %2d          %b",
                 $time, block_x, block_y, game_over);

        #10;
        $display("%4t       %2d           %2d          %b",
                 $time, block_x, block_y, game_over);

        $display("-----------------------------------------------");
        $display("Simulation completed successfully.");

        $finish;

    end

endmodule